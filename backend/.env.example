# Backend server port (optional)
PORT=3001

# Required for LLM summarization
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-1.5-flash

# Required for audio generation
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Free-tier API audio requires a generated/default voice you own; Voice Library/premade voices are blocked.
ELEVENLABS_VOICE_ID=

# Supabase (database)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# External Academic Databases & Search Providers
# ---------------------------------------------------------------------------

# Elsevier (ScienceDirect & Scopus)
# Portal: https://dev.elsevier.com/
ELSEVIER_API_KEY=
ELSEVIER_INST_TOKEN=

# Clarivate (Web of Science)
# Portal: https://developer.clarivate.com/
WEBOFSCIENCE_API_KEY=

# IEEE Xplore
# Portal: https://developer.ieee.org/
IEEE_API_KEY=

# OpenAlex (Optional premium key & polite pool email)
# https://openalex.org/
OPENALEX_API_KEY=
OPENALEX_EMAIL=

# Crossref (Polite pool contact email)
# https://www.crossref.org/
CROSSREF_EMAIL=
